<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE generatorConfiguration
        PUBLIC "-//mybatis.org//DTD MyBatis Generator Configuration 1.0//EN"
        "http://mybatis.org/dtd/mybatis-generator-config_1_0.dtd">

<generatorConfiguration>
    <context id="MySQLTables" targetRuntime="MyBatis3Simple">
        <commentGenerator>
            <property name="suppressAllComments" value="true"/>
            <property name="suppressDate" value="true"/>
        </commentGenerator>
        <jdbcConnection driverClass="com.mysql.cj.jdbc.Driver"
                        connectionURL="jdbc:mysql://localhost:3306/hrmdb?useInformationSchema=true"
                        userId="root"
                        password="123456"/>

        <javaModelGenerator targetPackage="com.hrm.persistence.entity" targetProject="src/main/java"/>
        <sqlMapGenerator targetPackage="mapper" targetProject="src/main/resources"/>
        <javaClientGenerator type="XMLMAPPER" targetPackage="com.hrm.persistence.mapper" targetProject="src/main/java"/>

        <!-- 13 tables — khớp sql/0.hrmdb.sql -->
        <!-- Domain 1: Organization -->
        <table schema="hrmdb" tableName="department"/>
        <table schema="hrmdb" tableName="job_position"/>
        <!-- Domain 2: Authority -->
        <table schema="hrmdb" tableName="sys_user"/>
        <table schema="hrmdb" tableName="role"/>
        <table schema="hrmdb" tableName="user_role"/>
        <table schema="hrmdb" tableName="permission"/>
        <table schema="hrmdb" tableName="position_permission"/>
        <!-- Domain 3: Employee -->
        <table schema="hrmdb" tableName="employee"/>
        <table schema="hrmdb" tableName="contract"/>
        <!-- Domain 4: Attendance -->
        <table schema="hrmdb" tableName="attendance_import"/>
        <table schema="hrmdb" tableName="daily_attendance"/>
        <table schema="hrmdb" tableName="attendance_summary"/>
        <table schema="hrmdb" tableName="leave_balance"/>
        <!-- Domain 5: Payroll — chưa có bảng trong sql/0.hrmdb.sql -->
    </context>
</generatorConfiguration>
