<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hrm.persistence.mapper.PayrollBatchMapper">
  <resultMap id="BaseResultMap" type="com.hrm.persistence.entity.PayrollBatch">
    <id column="batch_id" property="batchId"/>
    <result column="batch_name" property="batchName"/>
    <result column="period_month" property="periodMonth"/>
    <result column="period_year" property="periodYear"/>
    <result column="import_id" property="importId"/>
    <result column="run_at" property="runAt"/>
    <result column="run_by" property="runBy"/>
    <result column="batch_status" property="batchStatus"/>
    <result column="total_net" property="totalNet"/>
    <result column="status" property="status"/>
    <result column="created_at" property="createdAt"/>
  </resultMap>

  <insert id="insert" useGeneratedKeys="true" keyProperty="batchId"
          parameterType="com.hrm.persistence.entity.PayrollBatch">
    insert into payroll_batch (batch_name, period_month, period_year, import_id, run_at, run_by,
      batch_status, total_net, status)
    values (#{batchName}, #{periodMonth}, #{periodYear}, #{importId}, #{runAt}, #{runBy},
      #{batchStatus}, #{totalNet}, #{status})
  </insert>

  <delete id="deleteAll">
    delete from payroll_batch where batch_id > 0
  </delete>

  <select id="selectByPrimaryKey" resultMap="BaseResultMap">
    select * from payroll_batch where batch_id = #{batchId}
  </select>

  <select id="selectLatestDraft" resultMap="BaseResultMap">
    select * from payroll_batch order by batch_id desc limit 1
  </select>

  <select id="selectAll" resultMap="BaseResultMap">
    select * from payroll_batch order by batch_id desc
  </select>

  <update id="updateTotals">
    update payroll_batch set total_net = #{totalNet} where batch_id = #{batchId}
  </update>
</mapper>
